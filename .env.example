# ==============================================================================
# DevBloom — Variables de entorno para Docker Compose (Plantilla de ejemplo)
# Copia este archivo a '.env' en la raíz para desarrollo local:
#   cp .env.example .env
# ==============================================================================

# --- Base de datos (PostgreSQL 16) ---
POSTGRES_DB=devdaily
POSTGRES_USER=devbloom_user
POSTGRES_PASSWORD=devbloom_pass_local
DB_PORT=5432

# --- Backend (Spring Boot 3) ---
SPRING_PROFILES_ACTIVE=docker
DB_URL=jdbc:postgresql://db:5432/devdaily
DB_USERNAME=devbloom_user
DB_PASSWORD=devbloom_pass_local
JWT_SECRET=reemplazar_con_un_secreto_seguro_de_al_menos_256_bits_en_produccion_123456
JWT_EXPIRATION_MS=86400000
SERVER_PORT=8080

# --- Frontend (Vue 3 + Vite) ---
VITE_API_URL=http://localhost:8080
VITE_BASE_URL=/
FRONTEND_PORT=5173
